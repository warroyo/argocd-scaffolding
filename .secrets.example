# Secrets read by .github/workflows/apply.yml. For a local run, copy to .secrets
# (gitignored) and pass `--secret-file .secrets` to `gh act`. For a self-hosted
# runner, set each as a repo secret instead. Values mirror .env.example.

VCFA_REFRESH_TOKEN=
VCFA_URL=
VCFA_ORG=
REGION_NAME=

# Load-balancer mode — must match the region. Leave empty for the defaults
# (avi_enabled=false, no seg_name).
AVI_ENABLED=
SEG_NAME=

# bcrypt hash, same as TF_VAR_argo_password.
ARGO_PASSWORD=
# Empty uses argocd/repo-config.yaml.
REPO_URL=

# Optional: lets the "Commit generated files" step push from a local act run.
GITHUB_TOKEN=
