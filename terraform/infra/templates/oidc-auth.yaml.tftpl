# GENERATED by terraform/infra (local_file + templatefile) — DO NOT EDIT.
# Opt-in per cluster: accept VCFA tokens at the guest apiserver (structured
# AuthenticationConfiguration) so a user can paste the bearer their vcf CLI
# mints into Headlamp. issuer + CA are DERIVED from the VCFA this infra run
# targets (var.vcfa_url + a tls_certificate probe); audience is
# var.vcfa_oidc_audience. ORG-global — one VCFA org's identity plane, not keyed
# by env. Design: docs/ARCHITECTURE.md "VCFA identity"; rationale: DECISIONS #21.
apiVersion: kustomize.config.k8s.io/v1alpha1
kind: Component

patches:
- target:
    group: cluster.x-k8s.io
    version: v1beta1
    kind: Cluster
  patch: |-
    # variables/1 is the `kubernetes` entry in base/vks-cluster/cluster.yaml.
    # Adding this rolls the control plane once — see docs/DECISIONS.md #21.
    - op: add
      path: /spec/topology/variables/1/value/apiServerConfiguration
      value:
        extraAuthentication:
          jwt:
          - issuer:
              url: ${issuer}
              audiences:
              - ${audience}
              certificateAuthority: |
                ${indent(16, ca_pem)}
            claimMappings:
              # Byte-identical to the Concierge JWTAuthenticator in
              # base/argocd-attach-rbac/config (validate.sh parity check) — one
              # identity, one set of RBAC subjects across CLI (cert) and bearer.
              username:
                expression: 'claims.preferred_username'
              groups:
                expression: 'claims.?groups.orValue([]) + claims.?roles.orValue([])'
            userValidationRules:
            - expression: '!user.username.startsWith("system:")'
              message: "username must not use the system: prefix"
